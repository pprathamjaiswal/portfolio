# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it, and never paste these values
# into templates, JavaScript, or a public repository.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# Keep this False anywhere that is reachable from the internet.
DJANGO_DEBUG=True

# Comma separated. Required when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed in production so the contact form passes CSRF checks. Include the scheme.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Set to False if your host terminates TLS and already redirects HTTP.
# DJANGO_SECURE_SSL_REDIRECT=True

DJANGO_TIME_ZONE=Asia/Kolkata

# Leave blank for local SQLite. In production set this to a managed Postgres
# connection string — free hosts wipe the filesystem on every redeploy, so a
# SQLite file there loses every contact message.
# Neon (free, no expiry): https://neon.com
# DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Absolute base URL, used for canonical links, Open Graph tags and the sitemap.
SITE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# GitHub integration
# ---------------------------------------------------------------------------
# A fine-grained personal access token with READ-ONLY public repository access
# is enough. It is read by the Django process only and is never sent to the
# browser. Without it the site still works — GitHub just applies the lower
# unauthenticated rate limit.
GITHUB_TOKEN=
GITHUB_USERNAME=pprathamjaiswal

# Cache lifetime in seconds for GitHub responses (default: 6 hours).
GITHUB_CACHE_SECONDS=21600

# How many repositories to show.
GITHUB_MAX_REPOS=6

# Comma-separated repository names to hide from the site.
GITHUB_EXCLUDE_REPOS=pprathamjaiswal

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Messages accepted per IP address per hour.
CONTACT_RATE_LIMIT=5

# Where new enquiries are emailed. Leave blank to disable notifications —
# messages are still saved and readable at /admin/.
CONTACT_NOTIFY_EMAIL=pratham.m.jaiswal@gmail.com

# ---------------------------------------------------------------------------
# Email (Gmail example)
# ---------------------------------------------------------------------------
# Leave EMAIL_HOST_USER blank and mail is printed to the terminal instead of
# sent — useful for testing the whole flow without credentials.
#
# For Gmail you need an App Password, NOT your normal password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create one at https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below with NO spaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Optional. Defaults to "Portfolio <EMAIL_HOST_USER>".
# DEFAULT_FROM_EMAIL=Portfolio <you@gmail.com>
